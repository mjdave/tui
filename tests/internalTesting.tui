testSet = {}

testFunc = function()
{
    table.set8Add(testSet, 4)
    table.set8Add(testSet, 75)
    table.set8Add(testSet, 257)

    table.set16Add(testSet, 2743)
    table.set32Add(testSet, 235812)
    table.set64Add(testSet, 3284473232234432221)

    for(v in testSet)
    {
        print("got:", v)
    }

    if(testSet[4])
    {
        print("yes!")
    }

    if(testSet[67])
    {
        print("oh no!")
    }


    if(testSet[3284473232234432221])
    {
        print("yay!")
    }

    table.set8Remove(testSet, 75)

    print("after removing:", testSet)

    file.saveBinary("test.tuib", testSet)

    loaded = file.loadBinary("test.tuib")

    print("loaded:", loaded)
    
}

testFunc()
